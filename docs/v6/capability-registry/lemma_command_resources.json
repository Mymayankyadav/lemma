{
  "version": 2,
  "source": "D8(a) registered service-role-only public.mcp_command dispatcher",
  "resources": [
    {
      "resource": "study_entries",
      "command_fn": "study_command",
      "mcp_ok": true,
      "schema": {
        "operations": [
          "create",
          "update",
          "delete",
          "start",
          "pause",
          "resume",
          "break",
          "save",
          "discard"
        ],
        "fields": [
          "intent",
          "source",
          "reflection",
          "rating",
          "subject_id",
          "project_id",
          "checkpoint_id",
          "session_id"
        ]
      }
    },
    {
      "resource": "study_intervals",
      "command_fn": "study_command",
      "mcp_ok": true,
      "schema": {
        "operations": [
          "create",
          "update",
          "delete"
        ],
        "fields": [
          "entry_id",
          "kind",
          "started_at",
          "ended_at"
        ]
      }
    },
    {
      "resource": "calendar_blocks",
      "command_fn": "study_command",
      "mcp_ok": true,
      "schema": {
        "operations": [
          "create",
          "update",
          "delete"
        ],
        "fields": [
          "kind",
          "title",
          "starts_at",
          "ends_at",
          "time_zone",
          "status",
          "subject_id",
          "project_id",
          "checkpoint_id",
          "session_id"
        ]
      }
    },
    {
      "resource": "tasks",
      "command_fn": "task_command",
      "mcp_ok": true,
      "schema": {
        "operations": [
          "create",
          "update",
          "delete"
        ],
        "fields": [
          "title",
          "body",
          "subject_id",
          "project_id",
          "checkpoint_id",
          "estimate_minutes",
          "priority",
          "due_kind",
          "due_date",
          "due_at",
          "position",
          "status"
        ]
      }
    }
  ],
  "access": "service_role only for dispatcher; no unauthenticated or authenticated client privilege",
  "dispatch": "public.mcp_command resolves a resource only from this registry; it routes through the existing owner-bound public.mcp_<command_fn>(uuid,text,jsonb) bridge; no caller-supplied function name"
}
