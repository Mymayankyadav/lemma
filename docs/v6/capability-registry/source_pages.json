      "app_path": "read owner record",
      "mcp_path": "read owner record",
      "export": "include",
      "deletion": "follows owner record"
    },
    "updated_at": {
      "classification": "derived",
      "type": "timestamptz",
      "nullable": false,
      "default": "now()",
      "write": "database trigger clock_timestamp on every UPDATE",
      "app_path": "read owner record",
      "mcp_path": "read owner record",
      "export": "include",
      "deletion": "follows owner record"
    }
  }
}
