        "docs/SYNC_AUDIT_*.md", "docs/lanes/A.md", "test/account_*.js", "test/auth_*.js", "test/sync_*.js",
        "test/browser_sync.js", "test/conflict_*.js", "test/editor_persistence.js", "test/import_*.js",
